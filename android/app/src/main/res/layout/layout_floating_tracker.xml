<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_popup"
        android:elevation="8dp"
        android:padding="16dp">

        <!-- Top Header -->
        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Logo -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/alarm_logo" 
                android:scaleType="centerCrop"/>

            <!-- App Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="buddyplanner"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginLeft="6dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Timeline Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="타임라인"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />
                
            <!-- Close Button (Very subtle) -->
            <ImageButton
                android:id="@+id/btnClosePopup"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#666666" />
        </LinearLayout>

        <!-- Main Content Area -->
        <RelativeLayout
            android:id="@+id/rlContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/llHeader"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_toLeftOf="@+id/tvStatusEmoji"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <!-- Main Status with Time -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:id="@+id/tvPopupTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오전 07:00"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginRight="6dp"/>
                        
                    <TextView
                        android:id="@+id/tvPopupTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="준비중"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Sub Status -->
                <TextView
                    android:id="@+id/tvPopupStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="짐을 챙기고 있습니다"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Status Image (Using Emoji for now as dynamic images) -->
            <TextView
                android:id="@+id/tvStatusEmoji"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="🎒" 
                android:textSize="44sp" />

        </RelativeLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/pbPopupProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rlContent"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00E676" />

    </RelativeLayout>
</LinearLayout>
